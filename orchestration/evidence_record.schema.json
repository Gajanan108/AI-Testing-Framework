{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Security Assessment Evidence Record",
  "description": "Normalized record for an actual tool run. Planning states and illustrative samples are not execution evidence.",
  "type": "object",
  "required": [
    "schema_version",
    "assessment_id",
    "run_id",
    "tool_id",
    "target",
    "started_at",
    "finished_at",
    "execution_status",
    "tests",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "tool_id": {
      "type": "string",
      "minLength": 1
    },
    "tool_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "config_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^([a-fA-F0-9]{64})?$"
    },
    "target": {
      "type": "object",
      "required": [
        "name",
        "model_archetype"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_archetype": {
          "type": "string",
          "minLength": 1
        },
        "interface": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "execution_status": {
      "enum": [
        "COMPLETED",
        "PARTIAL",
        "FAILED"
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": true
    },
    "tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/test"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      },
      "default": []
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "test": {
      "type": "object",
      "required": [
        "test_id",
        "test_name",
        "status"
      ],
      "properties": {
        "test_id": {
          "type": "string",
          "minLength": 1
        },
        "test_name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "ERROR",
            "NOT_APPLICABLE"
          ]
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "observation": {
          "type": [
            "string",
            "null"
          ]
        },
        "metrics": {
          "type": "object"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": [
        "finding_id",
        "title",
        "category",
        "severity",
        "risky_behavior",
        "finding_verdict",
        "evidence_refs"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "INFO",
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL",
            "UNRATED"
          ]
        },
        "risky_behavior": {
          "type": "boolean"
        },
        "finding_verdict": {
          "enum": [
            "CONFIRMED_TRUE",
            "CONFIRMED_FALSE",
            "UNCONFIRMED"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "owasp_mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "framework",
              "version",
              "category_id",
              "category_name",
              "confidence"
            ],
            "properties": {
              "framework": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "category_id": {
                "type": "string"
              },
              "category_name": {
                "type": "string"
              },
              "confidence": {
                "enum": [
                  "HIGH",
                  "MEDIUM",
                  "LOW"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "media_type"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
