{
  "version": "1.0",
  "description": "Evidence-aware planning registry. Only the Presidio synthetic-fixture reference runner is locally executable by the MVP; ART notebooks require Colab and other tools require upstream configuration.",
  "tools": [
    {
      "id": "ibm_art_mineru_layout",
      "name": "IBM ART — MinerU PP-DocLayoutV2",
      "workstream": "adversarial_robustness",
      "execution_mode": "colab_notebook",
      "path": "embedding-model-testing/notebooks/mineru_ibm_art_layout_model_attacks.ipynb",
